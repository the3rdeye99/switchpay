{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "!dist/react/**", "!dist/next/**", "!dist/cli/**"]
    },
    "//#assemble": {
      "dependsOn": [
        "switchpay#build",
        "switchpay-react-internal#build",
        "switchpay-next-internal#build",
        "switchpay-cli-internal#build"
      ],
      "outputs": ["packages/core/dist/react/**", "packages/core/dist/next/**", "packages/core/dist/cli/**"]
    },
    "switchpay-example-app-router#build": {
      "dependsOn": ["^build", "//#assemble"]
    },
    "switchpay-example-pages-router#build": {
      "dependsOn": ["^build", "//#assemble"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "switchpay-example-app-router#dev": {
      "dependsOn": ["//#assemble"]
    },
    "switchpay-example-pages-router#dev": {
      "dependsOn": ["//#assemble"]
    },
    "switchpay#dev": {
      "dependsOn": ["^build", "//#assemble"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}