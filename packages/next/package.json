{
  "name": "switchpay-next-internal",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js App Router and Pages Router adapters for Switchpay (internal workspace package — published as switchpay/next, see scripts/assemble-publish-package.mjs)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "switchpay": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "next": "^14.0.0",
    "switchpay": "workspace:*",
    "@types/node": "^20.0.0"
  }
}
