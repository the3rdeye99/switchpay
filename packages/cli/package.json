{
  "name": "switchpay-cli-internal",
  "version": "0.1.0",
  "private": true,
  "description": "CLI for scaffolding Switchpay into a Next.js project (internal workspace package — published as the switchpay bin, see scripts/assemble-publish-package.mjs)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "switchpay": "./dist/index.js"
  },
  "files": ["dist", "src/templates"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  }
}
