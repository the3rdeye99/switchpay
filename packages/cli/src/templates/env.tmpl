# PayBridge configuration — see https://github.com/your-org/paybridge for docs.

# "paystack" or "flutterwave"
PAYBRIDGE_PROVIDER=paystack

# Provider secret key — server-side only, never exposed to the browser.
PAYBRIDGE_SECRET_KEY=

# Provider public key — safe to expose to the browser.
NEXT_PUBLIC_PAYBRIDGE_PUBLIC_KEY=

# Used to verify webhook signatures.
# For Paystack this is the same as your secret key.
# For Flutterwave this is the hash you configure in your dashboard.
PAYBRIDGE_WEBHOOK_SECRET=

# Optional — defaults to NGN if not set.
PAYBRIDGE_CURRENCY=NGN

# Optional — redirect URL after checkout completes.
PAYBRIDGE_CALLBACK_URL=
